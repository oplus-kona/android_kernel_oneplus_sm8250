#
# Automatically generated SCM-specific files.
#
*.[oa]
*.ko
*.mod.c
*.o.ur-safe
.*.cmd
*.ko.*
*.mod
modules.order
Module.symvers
modules.builtin

#
# Files generated by tests
#
*.gcno
*.gcda

#
# Generic git ignores
#
*.rej
*.orig
*.bak
*~
.#*
*#
.*.swp
.*.swo

#
# Top-level directories that may be generated
#
tar-install/

#
# git files that we don't want to ignore even it they are targets
#
!.gitignore
!.mailmap

#
# Generated include files
#
include/config
include/generated
arch/*/include/generated

#
# The arch-specific versions of generated files
#
arch/*/boot/Image
arch/*/boot/zImage
arch/*/boot/uImage
arch/*/boot/bootpImage
arch/*/boot/bootzImage
arch/*/boot/bzImage
arch/*/boot/Image.gz
arch/*/boot/Image.bz2
arch/*/boot/Image.lzma
arch/*/boot/Image.lzo
arch/*/boot/Image.lz4
arch/*/boot/Image.xz
arch/*/boot/vmlinux.bin
arch/*/boot/vmlinux.gz
arch/*/boot/vmlinux.bz2
arch/*/boot/vmlinux.lzma
arch/*/boot/vmlinux.lzo
arch/*/boot/vmlinux.lz4
arch/*/boot/vmlinux.xz
arch/*/boot/dtb.img
arch/*/boot/dtbo.img

#
# Generated autoksyms h files
#
include/generated/autoksyms.h

#
# Stashing reload files
#
*.staged
*.reloaded

#
# Temporary build artifacts
#
*.tmp

#
# asm-generic files
#
include/asm-generic/asm-offsets.h

#
# binaries
#
/vmlinux
/vmlinux.32
/vmlinux-gdb.py
/System.map
/Module.markers
/modules.builtin.modinfo

#
# Debian directory (generated when packaging a kernel)
#
debian/

#
# snapcraft directory (generated when packaging a snap)
#
.snapcraft/

#
# tar ball targets
#
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz

#
# Additional files
#
*.bin
*.bz2
*.lz4
*.lzma
*.lzo
*.patch
*.gcno
*.ll
*.[is]
*.s
*.su
*.xz
Module.symvers
all.config

# fetched Android config fragments
kernel/configs/android-*.cfg

out/
